// Prisma schema for justtoday.
// Source of truth for the database structure; see docs/core-spec.md §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plans Plan[]
}

model Plan {
  id               String   @id @default(cuid())
  userId           String
  title            String
  originalMarkdown String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  days Day[]

  @@index([userId])
}

enum DayStatus {
  pending
  completed
}

model Day {
  id          String    @id @default(cuid())
  planId      String
  dayNumber   Int
  status      DayStatus @default(pending)
  goal        String
  topics      String[]
  recap       String?
  feedback    String?
  completedAt DateTime?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dayNumber])
  @@index([planId])
}
