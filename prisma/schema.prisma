// Prisma schema for justtoday.
// Source of truth for the database structure; see docs/core-spec.md §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  plans    Plan[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Plan {
  id               String   @id @default(cuid())
  userId           String
  title            String
  originalMarkdown String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  days            Day[]
  conversations   DayConversation[]
  refinementChats PlanRefinementChat[]

  @@index([userId])
}

// One row per plan that was authored via the refinement chat path.
// `messages` stores the full UIMessage[] transcript verbatim, mirroring the
// shape used in DayConversation. The summary that became `Plan.originalMarkdown`
// is reconstructable from the transcript, so we don't duplicate it here.
model PlanRefinementChat {
  id        String   @id @default(cuid())
  planId    String
  messages  Json
  createdAt DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// One transcript per (plan, dayNumber) — only ever the in-progress day.
// `messages` stores the AI SDK's UIMessage[] verbatim (text + tool parts).
// Coupled to the SDK's wire shape on purpose; a single JSON column is cheap to migrate.
model DayConversation {
  id        String   @id @default(cuid())
  planId    String
  dayNumber Int
  messages  Json
  updatedAt DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dayNumber])
  @@index([planId])
}

enum DayStatus {
  pending
  completed
}

model Day {
  id          String    @id @default(cuid())
  planId      String
  dayNumber   Int
  status      DayStatus @default(pending)
  goal        String
  topics      String[]
  recap       String?
  feedback    String?
  completedAt DateTime?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, dayNumber])
  @@index([planId])
}
