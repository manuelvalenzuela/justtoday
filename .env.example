# Postgres connection string used by Prisma.
# Local dev example: postgresql://postgres:postgres@localhost:5432/justtoday?schema=public
# Azure Database for PostgreSQL example:
#   postgresql://USER:PASSWORD@HOST.postgres.database.azure.com:5432/justtoday?sslmode=require&schema=public
DATABASE_URL=

# Auth.js secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI for local dev:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Azure AI Foundry — chat model endpoint. Resource overview > Keys and Endpoint.
# Endpoint root, including trailing slash:
#   https://<resource>.cognitiveservices.azure.com/   (Foundry inference)
#   https://<resource>.openai.azure.com/              (Azure OpenAI)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
# Deployment name you assigned in Foundry (not the underlying model name).
AZURE_AI_DEPLOYMENT=gpt-5.4-pro
AZURE_AI_API_VERSION=2024-04-01-preview
